{
    "cli": {
      "version": ">= 12.0.0",
      "appVersionSource": "local"
    },
    "build": {
      "preview": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "env": {
          "EXPO_PUBLIC_API_URL": "https://REEMPLAZAR-URL-DEL-GATEWAY/api/v1",
          "EXPO_PUBLIC_PAGOS_REALES": "false"
        }
      },
      "production": {
        "android": {
          "buildType": "app-bundle"
        },
        "env": {
          "EXPO_PUBLIC_API_URL": "https://REEMPLAZAR-URL-DEL-GATEWAY/api/v1",
          "EXPO_PUBLIC_PAGOS_REALES": "false"
        }
      }
    }
  }