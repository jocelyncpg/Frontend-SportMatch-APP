# Copy to .env.local. Use an HTTPS gateway reachable from the phone for real builds.
EXPO_PUBLIC_API_URL=https://your-gateway.example/api/v1
# Existing EAS project UUID; not an Expo access token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Existing app identifiers, matching Firebase / Apple Developer configuration.
EXPO_ANDROID_PACKAGE=
EXPO_IOS_BUNDLE_IDENTIFIER=
# Android Firebase client config path (set as a file variable in EAS builds).
GOOGLE_SERVICES_JSON=
